# =============================================================================
# Lacrei Saúde — Configuração de Ambiente
# =============================================================================
# Copie este arquivo para .env e ajuste os valores antes de rodar o projeto.
#
#   cp .env.example .env
#
# =============================================================================

# --- Django ---
# ATENÇÃO: Em produção, NUNCA use valores padrão. Gere com:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=change-this-to-a-random-secret-key-50-chars-min
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO

# --- PostgreSQL (obrigatório para produção) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=lacrei
POSTGRES_USER=lacrei
POSTGRES_PASSWORD=change-this-password

# --- CORS ---
# Origens permitidas separadas por vírgula (sem espaços)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =============================================================================
# Notas para Produção (AWS):
#   - DJANGO_DEBUG=False (obrigatório)
#   - DJANGO_SECRET_KEY: variável de ambiente no ECS Task Definition
#   - POSTGRES_HOST: endpoint do RDS
#   - POSTGRES_PASSWORD: gerenciado via AWS Secrets Manager
#   - CORS_ALLOWED_ORIGINS: domínio do frontend em produção
# =============================================================================
